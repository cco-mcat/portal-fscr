# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies — repo dividido en backend/ y frontend/, cada uno con su
# propio node_modules/.next/out; sin el "/" inicial matchean en ambos.
node_modules
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage

# next.js
.next/
out/

# production
build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
*.log
